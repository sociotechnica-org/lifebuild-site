---
// LifeBuild.astro - Main page sections
// Sections: Hero, How It Works, Honest Alpha, About, Updates
---

<!-- ==================== HERO SECTION ==================== -->
<section class="hero" id="hero">
  <div class="container">
    <h2>You Used to Command Realms</h2>
    <div class="hero-video-container">
      <div class="hero-video-frame">
        <div class="hero-story">
          <img
            id="heroStoryFrame"
            src="/header-story/hero-story-1.webp"
            alt="Saturday morning at the desk, building a kingdom"
            class="hero-story-frame"
          />
          <img
            id="heroStoryOverlayFrame"
            src="/header-story/hero-story-1.webp"
            alt=""
            class="hero-story-frame is-overlay"
            aria-hidden="true"
          />
          <div class="hero-story-overlay">
            <button class="story-btn story-replay" id="heroStoryReplay" type="button">Replay</button
            >
          </div>
        </div>
      </div>
    </div>
    <div class="hero-content"></div>
  </div>
</section>

<!-- ==================== HOW IT WORKS SECTION ==================== -->
<section class="how-it-works" id="how-it-works">
  <div class="container">
    <h2>Reclaim Your Sovereignty</h2>
    <p class="how-subtitle">a living map of your world, an AI corps at your command.</p>
    <div class="how-it-works-grid">
      <div class="how-card">
        <img class="how-icon" src="/how-it-works/map.webp" alt="Map icon" />
        <h3>Map your world</h3>
        <p>
          Your whole life—eight domains, every project, all in one view. Zoom from the big picture
          to a single task. See everything, focus anywhere.
        </p>
      </div>
      <div class="how-card">
        <img class="how-icon" src="/how-it-works/owl.webp" alt="Owl icon" />
        <h3>Get wise counsel</h3>
        <p>
          AI advisors who know their domains. They spot blind spots, ask the right questions, and
          help you think strategically about what matters.
        </p>
      </div>
      <div class="how-card">
        <img class="how-icon" src="/how-it-works/crown.webp" alt="Crown icon" />
        <h3>Delegate the doing</h3>
        <p>
          AI workers handle the details. They capture, research, draft, and execute—with infinite
          patience and no ego.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ==================== HONEST ALPHA SECTION ==================== -->
<section class="honest-alpha" id="honest-alpha">
  <div class="container">
    <h2>The Honest Alpha</h2>
    <div class="honest-intro">
      <p>
        We're building LifeBuild in public. Rough edges, broken things, occasional catastrophic data
        loss. Also: you'll shape what this becomes.
      </p>
      <div class="security-note">
        <p>
          <strong>On security:</strong> Early-stage AI software is an even less secure place for personal
          information than big AI products—and that's a low bar. If that gives you pause, wait for Public
          Beta.
        </p>
      </div>
    </div>

    <div class="alpha-table-wrapper">
      <table class="alpha-table">
        <thead>
          <tr>
            <th>Stage</th>
            <th>What You Get</th>
            <th>What's Rough</th>
            <th>What We're Proving</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <span class="stage-name">Founding Alpha</span>
              <button
                class="btn-sketch stage-select"
                type="button"
                data-tag="founding-alpha"
                data-requires-name="true"
                aria-pressed="false">I'm in now</button
              >
            </td>
            <td
              >AI team for capturing and managing personal projects. Advisors in your areas of
              interest. Basic life overview.</td
            >
            <td>Ugly—mostly tables. Chatbot-feeling agents. Buggy. Frequent data loss.</td>
            <td>Can an AI team make life management feel like commanding instead of drowning?</td>
          </tr>
          <tr>
            <td>
              <span class="stage-name">Builder Alpha</span>
              <button
                class="btn-sketch stage-select"
                type="button"
                data-tag="builder-alpha"
                data-requires-name="true"
                aria-pressed="false">Notify me</button
              >
            </td>
            <td
              >Visual map. Worker AI that tasks at your command. On-brand interface. Agents with
              character and proactivity.</td
            >
            <td
              >Still crashing. We're pushing human-AI and AI-AI boundaries—which means breaking
              everything.</td
            >
            <td>Can the AI corps execute real work? Does the map create mastery?</td>
          </tr>
          <tr>
            <td>
              <span class="stage-name">Public Beta</span>
              <button
                class="btn-sketch stage-select"
                type="button"
                data-tag="public-beta"
                data-requires-name="true"
                aria-pressed="false">Notify me</button
              >
            </td>
            <td>Stable. Secure. Full functionality. Real onboarding.</td>
            <td>Less to shape—foundation is set.</td>
            <td>Can this scale beyond the people who watched us build it?</td>
          </tr>
          <tr>
            <td>
              <span class="stage-name">Post-Beta</span>
              <button
                class="btn-sketch stage-select"
                type="button"
                data-tag="post-beta"
                data-requires-name="true"
                aria-pressed="false">Notify me</button
              >
            </td>
            <td>The real thing, if it proves out.</td>
            <td>You missed the messy years.</td>
            <td>—</td>
          </tr>
        </tbody>
      </table>
    </div>

    <p class="just-watching-fallback">
      None of these stages fit?
      <button
        class="btn-sketch stage-select"
        type="button"
        data-tag="updates-only"
        data-requires-name="false"
        aria-pressed="false">Just watching</button
      > — we'll send occasional updates only.
    </p>

    <div class="alpha-signup is-collapsed" id="alpha-signup">
      <div class="alpha-signup-form-wrapper">
        <form
          id="alphaSignupForm"
          class="alpha-signup-form"
          action="https://buttondown.com/api/emails/embed-subscribe/sociotechnica"
          method="post"
          target="_blank"
        >
          <div class="form-group">
            <label for="alphaFullName"
              >Full name <span class="optional" id="alphaNameOptional">(optional)</span></label
            >
            <input
              type="text"
              id="alphaFullName"
              name="metadata__full_name"
              placeholder="First and last"
            />
          </div>

          <div class="form-group">
            <label for="alphaEmail">Email</label>
            <input
              type="email"
              id="alphaEmail"
              name="email"
              placeholder="you@example.com"
              required
            />
          </div>

          <div class="form-group">
            <label for="alphaFoundYou"
              >How did you find us? <span class="optional">(optional)</span></label
            >
            <input
              type="text"
              id="alphaFoundYou"
              name="metadata__found_you"
              placeholder="Friend, newsletter, labnotes, etc."
            />
          </div>

          <div class="form-group">
            <label for="alphaWhy"
              >Why are you joining? <span class="optional">(optional)</span></label
            >
            <textarea
              id="alphaWhy"
              name="metadata__why_joining"
              placeholder="What are you hoping LifeBuild helps with?"></textarea>
          </div>

          <input type="hidden" name="tag" id="alphaSignupTag" value="" />
          <input type="hidden" name="embed" value="1" />

          <div class="alpha-signup-actions">
            <button class="btn-sketch" type="submit">Submit</button>
            <div class="alpha-signup-error" id="alphaSignupError" role="alert" aria-live="polite">
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- ==================== ABOUT SECTION ==================== -->
<section class="about" id="about">
  <div class="container">
    <h2>About</h2>
    <div class="about-grid">
      <div class="about-panel">
        <h3>What we're betting on</h3>
        <p>
          We're using retro strategy games as a translational layer between humans and machines.
        </p>
        <ul class="bets-list">
          <li>
            <strong>AI-native foundation</strong>
            <span>Built for AI first, not bolted on.</span>
          </li>
          <li>
            <strong>Extremely visual</strong>
            <span>Give humans familiar visual tools to work with AI.</span>
          </li>
          <li>
            <strong>Collaborative authority</strong>
            <span>Agents who act, not just chat.</span>
          </li>
        </ul>
      </div>
      <div class="about-panel about-sidebar">
        <h3>Who's building this</h3>
        <p>Danvers & Jess.</p>
        <a href="https://sociotechnica.org/notebook/" target="_blank" rel="noopener noreferrer"
          >Follow the build →</a
        >
      </div>
    </div>
  </div>
</section>

<!-- ==================== UPDATES SECTION ==================== -->
<section class="updates" id="updates">
  <div class="container">
    <div class="updates-header">
      <h2>From the Workshop</h2>
      <a href="https://sociotechnica.org/notebook/" target="_blank" rel="noopener noreferrer"
        >Full labnotes →</a
      >
    </div>
    <div class="update-card">
      <div class="update-content">
        Coming soon...
      </div>
    </div>
  </div>
</section>

<style>
  /* ==================== HERO SECTION ==================== */
  .hero {
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding: 6rem 0 2rem;
  }

  .hero-video-container {
    width: 100%;
    max-width: 1180px;
    margin: 0 auto 2.5rem;
    position: relative;
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-video-frame {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.4),
      0 0 60px rgba(212, 160, 82, 0.1);
  }

  .hero-video-frame::before {
    content: '';
    position: absolute;
    inset: -3px;
    border: 3px solid var(--color-amber);
    border-radius: 12px;
    opacity: 0.3;
    transform: rotate(-0.3deg);
    pointer-events: none;
    z-index: 10;
  }

  .hero-video-frame::after {
    content: '';
    position: absolute;
    inset: -6px;
    border: 2px solid var(--color-amber);
    border-radius: 14px;
    opacity: 0.15;
    transform: rotate(0.5deg);
    pointer-events: none;
    z-index: 10;
  }

  .hero-story {
    position: relative;
    background: #f4ece0;
  }

  .hero-story-frame {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 300ms ease;
  }

  .hero-story-frame.is-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    pointer-events: none;
  }

  .hero-story-frame.is-overlay.is-active {
    opacity: 1;
  }

  .hero-story-frame.is-overlay.is-resetting {
    transition: none;
  }

  .hero-story-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 1.75rem;
    background: linear-gradient(180deg, rgba(244, 236, 224, 0) 0%, rgba(244, 236, 224, 0.92) 100%);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .story-replay {
    align-self: flex-end;
    opacity: 0;
    pointer-events: none;
    transform: translateY(6px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .story-replay.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .story-btn {
    font-family: var(--font-hand);
    font-size: 1.05rem;
    padding: 0.5rem 1.2rem;
    border-radius: 6px;
    border: 2px solid rgba(44, 36, 22, 0.3);
    background: rgba(255, 249, 240, 0.85);
    color: var(--color-ink);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .story-btn:hover {
    border-color: var(--color-amber);
    color: var(--color-amber);
    transform: translateY(-1px);
  }

  .hero-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto;
    padding: 0 1rem;
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }

  /* ==================== HOW IT WORKS SECTION ==================== */
  .how-it-works {
    background: transparent;
    position: relative;
  }

  .how-it-works::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    background: rgba(44, 36, 22, 0.08);
  }

  .how-it-works h2 {
    text-align: left;
    margin-bottom: 0.5rem;
  }

  .how-subtitle {
    text-align: left;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-cream-muted);
    margin-bottom: 3rem;
    letter-spacing: 0.05em;
  }

  .how-it-works-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .how-card {
    background: var(--color-bg-card);
    border: 2px solid rgba(44, 36, 22, 0.12);
    border-radius: 6px;
    padding: 1.8rem;
    position: relative;
    transition: all 0.3s ease;
    transform: rotate(var(--rotation, 0deg));
  }

  .how-card:nth-child(1) {
    --rotation: -0.5deg;
  }
  .how-card:nth-child(2) {
    --rotation: 0.3deg;
  }
  .how-card:nth-child(3) {
    --rotation: -0.3deg;
  }

  .how-card:hover {
    border-color: rgba(212, 160, 82, 0.4);
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  }

  .how-card h3 {
    margin-bottom: 0.8rem;
    font-size: 1.4rem;
  }

  .how-card p {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .how-icon {
    width: 120px;
    height: 120px;
    margin-bottom: 1rem;
    display: block;
    object-fit: contain;
    opacity: 0.82;
    filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.12));
  }

  /* ==================== HONEST ALPHA SECTION ==================== */
  .honest-alpha {
    background: transparent;
    position: relative;
  }

  .honest-alpha::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    background: rgba(44, 36, 22, 0.08);
  }

  .honest-alpha h2 {
    margin-bottom: 0.5rem;
  }

  .honest-intro {
    max-width: 700px;
    margin-bottom: 2.5rem;
  }

  .honest-intro > p {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .security-note {
    background: rgba(139, 58, 58, 0.08);
    border-left: 4px solid var(--color-red-deep);
    padding: 1rem 1.5rem;
    margin: 2rem 0;
    border-radius: 0 4px 4px 0;
    transform: rotate(-0.3deg);
  }

  .security-note p {
    font-family: var(--font-serif);
    font-size: 0.9rem;
  }

  .security-note strong {
    color: var(--color-cream);
  }

  .alpha-table-wrapper {
    background: rgba(255, 249, 240, 0.95);
    border-radius: 4px;
    padding: 2rem;
    transform: rotate(-0.3deg);
    box-shadow:
      4px 4px 0 var(--color-paper-dark),
      8px 8px 20px rgba(0, 0, 0, 0.3);
    position: relative;
    overflow: hidden;
  }

  .alpha-table-wrapper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: repeating-linear-gradient(
      transparent,
      transparent 31px,
      rgba(44, 36, 22, 0.08) 31px,
      rgba(44, 36, 22, 0.08) 32px
    );
    pointer-events: none;
  }

  .alpha-table-wrapper::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 60px;
    width: 2px;
    background: rgba(139, 58, 58, 0.2);
    pointer-events: none;
  }

  .alpha-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    position: relative;
    z-index: 1;
  }

  .alpha-table th {
    font-family: var(--font-hand);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-ink);
    text-align: left;
    padding: 0.8rem 0.6rem;
    border-bottom: 2px solid var(--color-ink-light);
  }

  .alpha-table td {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    padding: 1rem 0.6rem;
    border-bottom: 1px dashed rgba(44, 36, 22, 0.2);
    vertical-align: top;
    color: var(--color-ink);
    line-height: 1.6;
  }

  .alpha-table tr:last-child td {
    border-bottom: none;
  }

  .stage-name {
    font-family: var(--font-hand);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-ink);
    white-space: nowrap;
    display: block;
    margin-bottom: 0.35rem;
  }

  .stage-select {
    margin-top: 0.35rem;
  }

  .stage-select.is-selected {
    background: var(--color-ink);
    color: var(--color-paper);
    transform: rotate(0deg);
  }

  .just-watching-fallback {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-cream-muted);
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .just-watching-fallback .btn-sketch {
    margin: 0 0.25rem;
  }

  /* ==================== ALPHA SIGNUP FORM ==================== */
  .alpha-signup {
    margin-top: 2.5rem;
    scroll-margin-top: 140px;
  }

  .alpha-signup.is-collapsed {
    margin-top: 1rem;
  }

  .alpha-signup-form {
    display: grid;
    gap: 1.1rem;
    background: rgba(255, 249, 240, 0.9);
    border: 2px solid rgba(44, 36, 22, 0.12);
    border-radius: 8px;
    padding: 1.75rem;
    box-shadow: 3px 3px 0 var(--color-paper-dark);
    max-height: 1200px;
    opacity: 1;
    transform: translateY(0);
    transition:
      max-height 0.3s ease,
      opacity 0.25s ease,
      transform 0.25s ease;
    overflow: hidden;
  }

  .alpha-signup.is-collapsed .alpha-signup-form {
    max-height: 0;
    opacity: 0;
    transform: translateY(-6px);
    padding-top: 0;
    padding-bottom: 0;
    border-width: 0;
    box-shadow: none;
  }

  .alpha-signup-form .form-group {
    display: grid;
    gap: 0.4rem;
  }

  .alpha-signup-form label {
    font-family: var(--font-hand);
    font-size: 0.85rem;
    color: var(--color-ink-light);
  }

  .alpha-signup-form input[type='text'],
  .alpha-signup-form input[type='email'],
  .alpha-signup-form textarea {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    padding: 0.7rem 0.8rem;
    border-radius: 6px;
    border: 2px solid rgba(44, 36, 22, 0.2);
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-ink);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .alpha-signup-form textarea {
    min-height: 120px;
    resize: vertical;
  }

  .alpha-signup-form input:focus,
  .alpha-signup-form textarea:focus {
    outline: none;
    border-color: var(--color-amber);
    box-shadow: 0 0 0 3px rgba(212, 160, 82, 0.25);
  }

  .alpha-signup-form .optional {
    font-weight: 400;
    opacity: 0.7;
    font-size: 0.8rem;
  }

  .alpha-signup-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .alpha-signup-error {
    color: var(--color-red-deep);
    font-size: 0.9rem;
    font-family: var(--font-hand);
  }

  /* ==================== ABOUT SECTION ==================== */
  .about {
    background: transparent;
    position: relative;
  }

  .about::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    background: rgba(44, 36, 22, 0.08);
  }

  .about-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    margin-top: 2rem;
  }

  .about-panel {
    background: rgba(255, 249, 240, 0.75);
    border: 2px solid rgba(44, 36, 22, 0.12);
    border-radius: 8px;
    padding: 2rem;
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
  }

  .about h3 {
    color: var(--color-ink);
  }

  .about p,
  .about .about-note,
  .about .about-sidebar p,
  .about .bets-list span {
    font-family: var(--font-serif);
    color: var(--color-ink-light);
  }

  .bets-list {
    list-style: none;
    margin: 1.5rem 0;
  }

  .bets-list li {
    margin-bottom: 1.5rem;
    padding-left: 2rem;
    position: relative;
  }

  .bets-list li::before {
    content: '→';
    font-family: var(--font-hand);
    position: absolute;
    left: 0;
    top: 0;
    color: var(--color-amber);
    font-size: 1.2rem;
  }

  .bets-list strong {
    font-family: var(--font-hand);
    font-size: 1.2rem;
    color: var(--color-cream);
    display: block;
    margin-bottom: 0.25rem;
  }

  .bets-list span {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    color: var(--color-cream-muted);
  }

  .about-sidebar {
    display: grid;
    gap: 0.75rem;
  }

  .about-sidebar a {
    font-family: var(--font-hand);
    font-size: 1.1rem;
    color: var(--color-amber-deep);
    text-decoration: none;
  }

  .about-sidebar a:hover {
    text-decoration: underline;
  }

  /* ==================== UPDATES SECTION ==================== */
  .updates {
    background: transparent;
    position: relative;
  }

  .updates::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 1px;
    background: rgba(44, 36, 22, 0.08);
  }

  .updates-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .updates-header a {
    font-family: var(--font-hand);
    font-size: 1.1rem;
    color: var(--color-amber);
    text-decoration: none;
  }

  .updates-header a:hover {
    text-decoration: underline;
  }

  .update-card {
    background: var(--color-bg-card);
    border: 2px solid rgba(44, 36, 22, 0.12);
    border-radius: 6px;
    padding: 2rem;
    transform: rotate(0.2deg);
  }

  .update-date {
    font-family: var(--font-typewriter);
    font-size: 0.95rem;
    color: var(--color-cream-muted);
    margin-bottom: 1rem;
  }

  .update-content {
    font-family: var(--font-serif);
    color: var(--color-cream-muted);
    font-size: 1.1rem;
    line-height: 1.8;
    font-style: italic;
  }

  /* ==================== MOBILE STYLES ==================== */
  @media (max-width: 768px) {
    .hero-video-container {
      width: 100vw;
      margin: 0 calc(50% - 50vw) 2rem;
      max-width: none;
    }

    .hero-video-frame {
      border-radius: 0;
      box-shadow: none;
    }

    .hero-video-frame::before,
    .hero-video-frame::after {
      display: none;
    }

    .hero-story-overlay {
      padding: 1rem;
    }

    .alpha-table-wrapper {
      padding: 1rem;
      transform: none;
    }

    .alpha-table-wrapper::after {
      display: none;
    }

    .alpha-table {
      display: block;
      overflow-x: auto;
    }

    .how-card {
      transform: none !important;
    }
  }
</style>

<script>
  // Hero Story Animation
  const frames = [
    {
      src: '/header-story/hero-story-1.webp',
      alt: 'Saturday morning at the desk, building a kingdom',
    },
    {
      src: '/header-story/hero-story-2.webp',
      alt: 'Dusk settles over the desk and the kingdom',
    },
    {
      src: '/header-story/hero-story-3.webp',
      alt: 'Night settles in with the same map open',
    },
    {
      src: '/header-story/hero-story-4.webp',
      alt: 'Bills and paperwork crowd the desk',
    },
    {
      src: '/header-story/hero-story-5.webp',
      alt: 'Sticky notes and reminders crowd the screen',
    },
    {
      src: '/header-story/hero-story-6.webp',
      alt: 'The screen shrinks as the tasks grow',
    },
    {
      src: '/header-story/hero-story-7.webp',
      alt: 'A busy calendar replaces the game',
    },
    {
      src: '/header-story/hero-story-8.webp',
      alt: 'A calendar view fills the screen',
    },
  ];

  const frameImage = document.getElementById('heroStoryFrame') as HTMLImageElement | null;
  const overlayImage = document.getElementById('heroStoryOverlayFrame') as HTMLImageElement | null;
  const replayButton = document.getElementById('heroStoryReplay');

  let currentIndex = 0;
  let _isPlaying = false;
  let timer: number | null = null;
  const frameDuration = 1100;
  const autoStartDelay = 900;

  const updateFrame = (index: number) => {
    const safeIndex = (index + frames.length) % frames.length;
    const frame = frames[safeIndex];

    if (!overlayImage || !frameImage) {
      if (frameImage) {
        frameImage.src = frame.src;
        frameImage.alt = frame.alt;
      }
    } else {
      if (overlayImage.classList.contains('is-active')) {
        overlayImage.classList.add('is-resetting');
        overlayImage.classList.remove('is-active');
        void overlayImage.offsetHeight; // Force reflow
        overlayImage.classList.remove('is-resetting');
      }

      const onTransitionEnd = () => {
        frameImage.src = frame.src;
        frameImage.alt = frame.alt;
        overlayImage.classList.add('is-resetting');
        overlayImage.classList.remove('is-active');
        void overlayImage.offsetHeight; // Force reflow
        overlayImage.classList.remove('is-resetting');
        overlayImage.removeEventListener('transitionend', onTransitionEnd);
      };

      overlayImage.addEventListener('transitionend', onTransitionEnd);
      overlayImage.src = frame.src;
      overlayImage.alt = frame.alt;
      overlayImage.addEventListener(
        'load',
        () => {
          window.requestAnimationFrame(() => {
            overlayImage.classList.add('is-active');
          });
        },
        { once: true }
      );
    }

    currentIndex = safeIndex;
    if (replayButton && currentIndex < frames.length - 1) {
      replayButton.classList.remove('is-visible');
    }
  };

  const stopPlayback = () => {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
    _isPlaying = false;
    if (replayButton) {
      replayButton.classList.add('is-visible');
    }
  };

  const startPlayback = () => {
    if (timer) {
      clearInterval(timer);
    }
    _isPlaying = true;
    if (replayButton) {
      replayButton.classList.remove('is-visible');
    }
    timer = window.setInterval(() => {
      if (currentIndex >= frames.length - 1) {
        stopPlayback();
        return;
      }
      updateFrame(currentIndex + 1);
    }, frameDuration);
  };

  if (replayButton) {
    replayButton.addEventListener('click', () => {
      currentIndex = 0;
      updateFrame(0);
      startPlayback();
    });
  }

  // Respect reduced motion preference
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!prefersReducedMotion.matches) {
    window.setTimeout(() => {
      startPlayback();
    }, autoStartDelay);
  } else {
    stopPlayback();
  }

  // ==================== ALPHA SIGNUP FORM LOGIC ====================
  const stageButtons = Array.from(
    document.querySelectorAll('.stage-select')
  ) as HTMLButtonElement[];
  const signupForm = document.getElementById('alphaSignupForm') as HTMLFormElement | null;
  const signupTag = document.getElementById('alphaSignupTag') as HTMLInputElement | null;
  const nameInput = document.getElementById('alphaFullName') as HTMLInputElement | null;
  const nameOptional = document.getElementById('alphaNameOptional');
  const signupError = document.getElementById('alphaSignupError');
  const signupSection = document.getElementById('alpha-signup');

  const setSignupCollapsed = (isCollapsed: boolean) => {
    if (!signupSection) {
      return;
    }
    signupSection.classList.toggle('is-collapsed', isCollapsed);
  };

  const clearSelection = () => {
    stageButtons.forEach((item) => {
      item.classList.remove('is-selected');
      item.setAttribute('aria-pressed', 'false');
    });
    if (signupTag) {
      signupTag.value = '';
    }
    if (nameInput) {
      nameInput.required = false;
    }
    if (nameOptional) {
      nameOptional.style.display = 'inline';
    }
    if (signupError) {
      signupError.textContent = '';
    }
    setSignupCollapsed(true);
  };

  const selectStage = (button: HTMLButtonElement) => {
    const isAlreadySelected = button.classList.contains('is-selected');
    if (isAlreadySelected) {
      clearSelection();
      return;
    }

    stageButtons.forEach((item) => {
      item.classList.remove('is-selected');
      item.setAttribute('aria-pressed', 'false');
    });

    button.classList.add('is-selected');
    button.setAttribute('aria-pressed', 'true');
    if (signupTag) {
      signupTag.value = button.dataset.tag || '';
    }

    const requiresName = button.dataset.requiresName === 'true';
    if (nameInput) {
      nameInput.required = requiresName;
    }
    if (nameOptional) {
      nameOptional.style.display = requiresName ? 'none' : 'inline';
    }

    if (signupError) {
      signupError.textContent = '';
    }

    setSignupCollapsed(false);
  };

  stageButtons.forEach((button) => {
    button.addEventListener('click', () => {
      selectStage(button);
      if (signupSection && signupTag?.value) {
        signupSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  if (signupForm) {
    signupForm.addEventListener('submit', (event) => {
      if (!signupTag?.value) {
        event.preventDefault();
        if (signupError) {
          signupError.textContent = 'please select a stage in the list above';
        }
        if (signupSection) {
          signupSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        return;
      }

      if (signupError) {
        signupError.textContent = '';
      }

      window.setTimeout(() => {
        signupForm.reset();
        clearSelection();
      }, 100);
    });
  }

  // Start with form collapsed
  setSignupCollapsed(true);
</script>
